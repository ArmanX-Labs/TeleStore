{
  "build": {
    "beforeDevCommand": "npm run dev --prefix frontend",
    "beforeBuildCommand": "npm run build --prefix frontend",
    "devPath": "http://localhost:5173",
    "distDir": "frontend/dist",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "MyCloud",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": true
    },
    "bundle": {
      "identifier": "com.mycloud.app",
      "icon": []
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "MyCloud Desktop",
        "width": 1000,
        "height": 700,
        "resizable": true
      }
    ]
  }
}
